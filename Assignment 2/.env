# Ports
GATEWAY_PORT=8080
TUTOR_GRPC_PORT=50051
SESSION_GRPC_PORT=50052

# Databases (each service has its own)
DB_PORT=5432
TUTOR_DB_USER=tutor
TUTOR_DB_PASSWORD=tutorpass
TUTOR_DB_NAME=tutordb
SESSION_DB_USER=session
SESSION_DB_PASSWORD=sessionpass
SESSION_DB_NAME=sessiondb

# Resilience settings for Session service -> Tutor service
TUTOR_TIMEOUT_MS=2000
TUTOR_MAX_RETRIES=2
CB_FAILURE_THRESHOLD=5
CB_OPEN_SECONDS=10
