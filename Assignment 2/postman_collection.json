    {
      "name": "Resilience (stop tutor-service first)",
      "description": "",
      "item": [
        {
          "name": "Create Session - tutor service down (503)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Error message returned\", function () { pm.expect(pm.response.json().error).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tutor_id\": \"{{tutorId}}\",\n  \"student_name\": \"Pema Lhamo\",\n  \"session_date\": \"2026-10-20\",\n  \"duration_minutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run: docker compose stop tutor-service. Send this 2-3 times: retries first, then the circuit breaker opens and it fails fast."
          }
        },
        {
          "name": "Get Session - fallback response (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Fallback tutor_name used\", function () { pm.expect(pm.response.json().tutor_name).to.include(\"unavailable\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "{{sessionId}}"
              ]
            },
            "description": "With tutor-service stopped, the session is still returned with a fallback tutor_name."
          }
        },
        {
          "name": "Create Session - after recovery (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"tutor_name comes from Tutor service\", function () { pm.expect(pm.response.json().tutor_name).to.eql(\"Karma Dorji\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tutor_id\": \"{{tutorId}}\",\n  \"student_name\": \"Pema Lhamo\",\n  \"session_date\": \"2026-10-20\",\n  \"duration_minutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run: docker compose start tutor-service, wait ~15s, then send."
          }
        }
